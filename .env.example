PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/sangi?retryWrites=true&w=majority

JWT_SECRET=sangi_super_secret_key_change_in_prod
JWT_REFRESH_SECRET=sangi_refresh_secret_key_change_in_prod

# ImageKit
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id/

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# OTP Mode: mock (returns 1234) | live (uses MSG91)
OTP_MODE=mock
MSG91_AUTH_KEY=your_msg91_auth_key
